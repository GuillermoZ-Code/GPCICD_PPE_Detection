# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/
.venv/
.uv/

# Testing / linting caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

# Entorno y secretos (NUNCA versionar)
.env
.env.*
!.env.example
*.pem
*.key

# Artefactos pesados / datos (revisar caso a caso)
data/
dataset_limpio/
dataset_original/
datasets/
_original/
artifacts/
weights/
*.h5
*.pt
*.pth
*.onnx
*.safetensors
*.sqlite
*.db
*.zip

# Notebooks (el curso exige scripts versionados, no .ipynb)
*.ipynb

# MLflow / Ultralytics (salidas locales)
runs/
mlruns/
mlartifacts/
mlflow.db

# Sistema operativo / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Slidev (si aplica)
node_modules/
.slidev/
*.png.tmp

# Índice de tgrep
.tgrep/

# Archify: recibos y evidencias de regeneración (el fuente es arquitectura.json)
docs/architecture/*.finalize*.json
docs/architecture/*.browser-check.json
docs/architecture/*.delivery.json
docs/architecture/review-*/

# Spec Kit: caché local de extensiones
.specify/extensions/.cache/
.specify/extensions/.registry
