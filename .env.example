# Configuración de la API y el detector (HU-044). Copiar como .env y ajustar.
# Nunca versionar secretos ni rutas personales.

# Modelo
PPE_MODEL_PATH=/models/best.pt
PPE_MODEL_MANIFEST=
PPE_MODEL_VERSION=yolo11s-clean
PPE_MODEL_SHA256=
PPE_MODEL_FORMAT=pt

# Inferencia (mismos defaults que src/ppe_detection/detection/yolo.py)
PPE_CONF=0.25
PPE_IOU=0.7
PPE_IMGSZ=640
PPE_DEVICE=cpu

# API REST
PPE_API_HOST=0.0.0.0
PPE_API_PORT=8000
PPE_CORS_ORIGINS=http://localhost:5173
# MaaS (HU-051): claves para X-API-Key en /predict. Vacía = sin autenticación.
# PPE_API_KEYS admite varias claves separadas por comas; PPE_API_KEY se mantiene
# por compatibilidad y se usa solo si PPE_API_KEYS está vacía.
PPE_API_KEYS=
PPE_API_KEY=

# gRPC
PPE_GRPC_HOST=0.0.0.0
PPE_GRPC_PORT=9000
PPE_GRPC_TARGET=127.0.0.1:9000

# Verificación remota (HU-050): URL base usada por smoke_remote.
PPE_API_URL=http://127.0.0.1:8000
# Límite de subida en MB (HU-048); vacío usa el máximo por defecto de la API
PPE_MAX_UPLOAD_MB=
# Despliegue (HU-060): origen publicado y commit desplegado que expone /health
PPE_SOURCE_URL=
PPE_DEPLOY_COMMIT=
# Prueba de carga (HU-063): "usuario:clave" para basic auth; vacío = sin auth.
# Se lee del entorno en el momento del ensayo; nunca se escribe en el informe.
PPE_LOAD_AUTH=
